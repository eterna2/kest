          ]
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@kest.internal",
      "firstName": "Bob",
      "lastName": "Kest",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "kest-admin",
        "kest-reader"
      ],
      "clientConsents": [
        {
          "clientId": "kest-cli",
          "grantedClientScopes": [
            "read:data",
            "write:data"
          ]
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "web-origins"
  ],
  "defaultOptionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "read:data",
    "write:data"
  ]
}